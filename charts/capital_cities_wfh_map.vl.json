{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 800,
    "height": 450,
    "title": {
        "text": "Capital city WFH rates",
        "fontSize": 18,
        "anchor": "start",
        "dy": -10
    },
    "projection": {"type": "mercator"},
    "layer": [
        {
            "data": {
                "url": "./topojson/GCCSA_2021_AUST_GDA2020.json",
                "format": {"type": "topojson", "feature":"GCCSA_2021_AUST_GDA2020"}
            },
            "mark": {"type": "geoshape", "fill": "#dddddd", "stroke":"white"}
        },
        {
            "data": {
                "url": "./data/roy-morgan/capital_cities_wfh.json"
            },
            "transform": [
                {
                    "calculate": "if(datum.percent < 40, '30-39', if(datum.percent < 50, '40-49', '50+'))",
                    "as": "wfh_band"
                }
            ],
            "mark": {"type": "circle"},
            "encoding": {
                "longitude": {"field": "longitude", "type": "quantitative"},
                "latitude": {"field": "latitude", "type": "quantitative"},
                "size": {
                    "field": "wfh_band",
                    "type": "nominal",
                    "title": "WFH percent",
                    "sort": ["30-39", "40-49", "50+"],
                    "scale": {
                        "range": [120, 500, 1800]
                    },
                    "legend": {}
                },
                "tooltip": [
                { "field": "location", "title": "City", "type": "nominal" },
                { "field": "percent", "title": "WFH percent", "type": "quantitative" }]
            }
        }
    ]
}