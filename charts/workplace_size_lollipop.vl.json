{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 420,
  "height": 420,
  "title": {
    "text": "WFH by workplace size",
    "fontSize": 18,
    "anchor": "start",
    "dy": -10
  },
  "data": { "url": "../data/roy-morgan/workplace_size.json" },
  "transform": [
    { "filter": "datum.response == 'Work from home'" }
  ],
  "encoding": {
    "y": {
      "field": "workplace_size",
      "type": "nominal",
      "sort": { "field": "order", "order": "ascending" },
      "title": null
    },
    "x": {
      "field": "percent",
      "type": "quantitative",
      "title": "Work from home (%)",
      "scale": { "domain": [0, 60] }
    },
    "color": { "value": "#54a24b" }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#54a24b",
        "strokeWidth": 2
      },
      "encoding": {
        "x": { "field": "percent", "type": "quantitative" },
        "x2": { "datum": 0 },
        "y": {
          "field": "workplace_size",
          "type": "nominal",
          "sort": { "field": "order", "order": "ascending" }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "stroke": "#54a24b",
        "opacity": 1,
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": { "field": "percent", "type": "quantitative" },
        "y": {
          "field": "workplace_size",
          "type": "nominal",
          "sort": { "field": "order", "order": "ascending" }
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 11
    }
  }
}
